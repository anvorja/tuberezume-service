# Copia este archivo a .env y ajusta lo que necesites. No subas .env al repositorio.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600

# Orígenes permitidos por CORS, separados por coma (frontend local y/o desplegado)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tuberezume.netlify.app
# Regex opcional para previews de Netlify: ^https://[\w-]+--tuberezume\.netlify\.app$
CORS_ORIGIN_REGEX=

# Clave de acceso. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Obligatoria si expones el backend (ngrok, nube). Vacía = sin protección, solo para uso local.
API_TOKEN=

DB_PATH=data/rezume.db
SUMMARY_LANGUAGE=español
# Búsqueda web de contexto activada por defecto (cada petición puede cambiarlo)
WEB_SEARCH_DEFAULT=false
# Duración objetivo de cada tramo cuando el video no trae capítulos
CHUNK_SECONDS=360
